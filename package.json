{
  "name": "integration-playground",
  "version": "1.0.0",
  "description": "API Launch Dashboard — interactive integration playground",
  "scripts": {
    "dev": "concurrently --names \"SERVER,CLIENT\" --prefix-colors \"yellow,cyan\" \"node server.js\" \"npm run dev --prefix client\"",
    "install:all": "npm install && npm install --prefix client"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "concurrently": "^8.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  }
}
